#############################################
# Utility command for package

build modules/features2d/CMakeFiles/package.util: CUSTOM_COMMAND modules/features2d/all
  COMMAND = cd /root/opencv/build-4.9 && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build modules/features2d/package: phony modules/features2d/CMakeFiles/package.util


