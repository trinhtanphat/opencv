build modules/features2d/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /root/opencv/build-4.9 && /usr/bin/cpack --config ./CPackSourceConfig.cmake /root/opencv/build-4.9/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build modules/features2d/package_source: phony modules/features2d/CMakeFiles/package_source.util


